<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.CategoryView">

    <VerticalStackLayout Spacing="4">

        <!-- Entire header is now tappable -->
        <Border
            x:Name="CategoryBorder"
            Margin="0,5"
            Padding="12"
            Stroke="{AppThemeBinding Light=LightGray, Dark=Gray}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>

            <!-- Soft Fluent-style highlight -->
            <Border.Triggers>

                <DataTrigger TargetType="Border"
                             Binding="{Binding IsExpanded}"
                             Value="True">

                    <Setter Property="Stroke" Value="#BFD8FF"/>
                    <Setter Property="BackgroundColor"
                            Value="{AppThemeBinding Light=#F8FBFF, Dark=#1B2430}"/>

                </DataTrigger>

                <DataTrigger TargetType="Border"
                             Binding="{Binding IsExpanded}"
                             Value="False">

                    <Setter Property="Stroke"
                            Value="{AppThemeBinding Light=LightGray, Dark=Gray}"/>
                    <Setter Property="BackgroundColor"
                            Value="Transparent"/>

                </DataTrigger>

            </Border.Triggers>

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="CategoryTapped"/>
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Grid.Column="0"
                    Text="{Binding Name}"
                    FontAttributes="Bold"
                    FontSize="18"
                    VerticalOptions="Center"/>

                <!-- Rotating chevron -->
                <Label
                    Grid.Column="1"
                    Text="›"
                    FontSize="22"
                    VerticalOptions="Center">

                    <Label.Triggers>

                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsExpanded}"
                                     Value="True">
                            <Setter Property="Rotation" Value="90"/>
                        </DataTrigger>

                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsExpanded}"
                                     Value="False">
                            <Setter Property="Rotation" Value="0"/>
                        </DataTrigger>

                    </Label.Triggers>

                </Label>

            </Grid>

        </Border>

        <VerticalStackLayout
            IsVisible="{Binding IsExpanded}"
            Padding="25,0,0,5"
            Spacing="4">

            <CollectionView ItemsSource="{Binding Websites}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Label
                            Text="{Binding Name}"
                            FontSize="15"/>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentView>