<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.CategoryView">

    <Border
        Margin="{OnPlatform WinUI='0,1',
                            Android='0,3',
                            iOS='0,3',
                            MacCatalyst='0,2'}"
        Padding="0"
        Stroke="{AppThemeBinding Light=#B7CAE8, Dark=#41628F}"
        StrokeThickness="1"
        BackgroundColor="{AppThemeBinding Light=#F7FAFE, Dark=#1B2940}">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto,Auto,Auto">

            <!-- =====================================================
                 CATEGORY HEADER
                 ===================================================== -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto,Auto"
                ColumnSpacing="{OnPlatform WinUI=2,
                                           Android=4,
                                           iOS=4,
                                           MacCatalyst=3}"
                Padding="{OnPlatform WinUI='12,0',
                                     Android='12,3',
                                     iOS='12,3',
                                     MacCatalyst='12,2'}">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CategoryTapped"/>
                </Grid.GestureRecognizers>

                <!-- Category Name -->
                <Label
                    Grid.Column="0"
                    Text="{Binding Name}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    FontAttributes="Bold"
                    FontSize="18"
                    VerticalOptions="Center">

                    <Label.Triggers>

                        <!--
                            Black and White both mean:
                            use the normal readable color
                            for the current appearance.
                        -->
                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#000000">

                            <Setter
                                Property="TextColor"
                                Value="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#FFFFFF">

                            <Setter
                                Property="TextColor"
                                Value="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#0000CD">
                            <Setter Property="TextColor" Value="#0000CD"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#FF0000">
                            <Setter Property="TextColor" Value="#FF0000"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#00FF00">
                            <Setter Property="TextColor" Value="#00FF00"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#FFA500">
                            <Setter Property="TextColor" Value="#FFA500"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#4B0082">
                            <Setter Property="TextColor" Value="#4B0082"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#8F00FF">
                            <Setter Property="TextColor" Value="#8F00FF"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#D3D3D3">
                            <Setter Property="TextColor" Value="#D3D3D3"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#808080">
                            <Setter Property="TextColor" Value="#808080"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#008080">
                            <Setter Property="TextColor" Value="#008080"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding TextColor}"
                            Value="#FFD700">
                            <Setter Property="TextColor" Value="#FFD700"/>
                        </DataTrigger>

                    </Label.Triggers>

                </Label>

                <!-- Category Edit -->
                <Button
                    Grid.Column="1"
                    ImageSource="{AppThemeBinding Light=edit_light.png, Dark=edit_dark.png}"
                    BackgroundColor="Transparent"
                    WidthRequest="{OnPlatform WinUI=28,
                                              Android=44,
                                              iOS=44,
                                              MacCatalyst=34}"
                    HeightRequest="{OnPlatform WinUI=28,
                                               Android=44,
                                               iOS=44,
                                               MacCatalyst=34}"
                    MinimumHeightRequest="{OnPlatform WinUI=0}"
                    Padding="{OnPlatform WinUI=3,
                                         Android=14,
                                         iOS=14,
                                         MacCatalyst=9}"
                    Opacity="0.82"
                    Clicked="EditCategory_Clicked"/>

                <!-- Category Delete -->
                <Button
                    Grid.Column="2"
                    ImageSource="{AppThemeBinding Light=delete_light.png, Dark=delete_dark.png}"
                    BackgroundColor="Transparent"
                    WidthRequest="{OnPlatform WinUI=28,
                                              Android=44,
                                              iOS=44,
                                              MacCatalyst=34}"
                    HeightRequest="{OnPlatform WinUI=28,
                                               Android=44,
                                               iOS=44,
                                               MacCatalyst=34}"
                    MinimumHeightRequest="{OnPlatform WinUI=0}"
                    Padding="{OnPlatform WinUI=3,
                                         Android=14,
                                         iOS=14,
                                         MacCatalyst=9}"
                    Opacity="0.82"
                    Clicked="DeleteCategory_Clicked">

                    <Button.Triggers>

                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentView}},
                                              Path=Settings.ConfirmDelete}"
                            Value="False">

                            <Setter
                                Property="ImageSource"
                                Value="delete_red.png"/>

                            <Setter
                                Property="Opacity"
                                Value="1"/>

                        </DataTrigger>

                    </Button.Triggers>

                </Button>

                <!-- Expand / Collapse -->
                <Image
                    Grid.Column="3"
                    Source="{AppThemeBinding Light=chevron_light.png, Dark=chevron_dark.png}"
                    WidthRequest="{OnPlatform WinUI=18,
                                              Android=28,
                                              iOS=28,
                                              MacCatalyst=22}"
                    HeightRequest="{OnPlatform WinUI=18,
                                               Android=28,
                                               iOS=28,
                                               MacCatalyst=22}"
                    Margin="0"
                    Opacity="0.82"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Image.Triggers>

                        <DataTrigger
                            TargetType="Image"
                            Binding="{Binding IsExpanded}"
                            Value="True">
                            <Setter Property="Rotation" Value="90"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Image"
                            Binding="{Binding IsExpanded}"
                            Value="False">
                            <Setter Property="Rotation" Value="0"/>
                        </DataTrigger>

                    </Image.Triggers>

                </Image>

            </Grid>

            <!-- =====================================================
                 CATEGORY / WEBSITE SEPARATOR
                 Slightly stronger than website separators
                 ===================================================== -->

            <BoxView
                Grid.Row="1"
                IsVisible="{Binding IsExpanded}"
                HeightRequest="1"
                Margin="16,0,16,0"
                BackgroundColor="{AppThemeBinding
                    Light=#C9D7EA,
                    Dark=#3A5575}"/>

            <!-- =====================================================
                 WEBSITE AREA
                 ===================================================== -->

            <VerticalStackLayout
                Grid.Row="2"
                IsVisible="{Binding IsExpanded}"
                BindableLayout.ItemsSource="{Binding Websites}"
                Padding="{OnPlatform WinUI='12,0',
                                     Android='12,0,12,2',
                                     iOS='12,0,12,2',
                                     MacCatalyst='12,0,12,1'}"
                Spacing="0">

                <BindableLayout.ItemTemplate>

                    <DataTemplate>

                        <Grid
                            RowDefinitions="Auto,1"
                            Margin="18,0,0,0">

                            <!-- Website Row -->
                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="*,Auto"
                                Padding="{OnPlatform WinUI='4,1',
                                                     Android='4,2',
                                                     iOS='4,2',
                                                     MacCatalyst='4,1'}"
                                MinimumHeightRequest="{OnPlatform WinUI=30}">

                                <!-- Website Name -->
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Name}"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    FontSize="15"
                                    VerticalOptions="Center"
                                    ToolTipProperties.Text="{Binding Url}">

                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="WebsiteName_Tapped"/>
                                    </Label.GestureRecognizers>

                                    <Label.Triggers>

                                        <!--
                                            Black and White both mean:
                                            use the normal readable color
                                            for the current appearance.
                                        -->
                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#000000">

                                            <Setter
                                                Property="TextColor"
                                                Value="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#FFFFFF">

                                            <Setter
                                                Property="TextColor"
                                                Value="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#0000CD">
                                            <Setter Property="TextColor" Value="#0000CD"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#FF0000">
                                            <Setter Property="TextColor" Value="#FF0000"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#00FF00">
                                            <Setter Property="TextColor" Value="#00FF00"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#FFA500">
                                            <Setter Property="TextColor" Value="#FFA500"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#4B0082">
                                            <Setter Property="TextColor" Value="#4B0082"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#8F00FF">
                                            <Setter Property="TextColor" Value="#8F00FF"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#D3D3D3">
                                            <Setter Property="TextColor" Value="#D3D3D3"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#808080">
                                            <Setter Property="TextColor" Value="#808080"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#008080">
                                            <Setter Property="TextColor" Value="#008080"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding TextColor}"
                                            Value="#FFD700">
                                            <Setter Property="TextColor" Value="#FFD700"/>
                                        </DataTrigger>

                                    </Label.Triggers>

                                </Label>

                                <!-- Website Actions -->
                                <HorizontalStackLayout
                                    Grid.Column="1"
                                    Spacing="{OnPlatform WinUI=2,
                                                         Android=3,
                                                         iOS=3,
                                                         MacCatalyst=2}"
                                    VerticalOptions="Center">

                                    <!-- Website Edit -->
                                    <Button
                                        ImageSource="{AppThemeBinding Light=edit_light.png, Dark=edit_dark.png}"
                                        BackgroundColor="Transparent"
                                        WidthRequest="{OnPlatform WinUI=30,
                                                                  Android=42,
                                                                  iOS=42,
                                                                  MacCatalyst=30}"
                                        HeightRequest="{OnPlatform WinUI=30,
                                                                   Android=42,
                                                                   iOS=42,
                                                                   MacCatalyst=30}"
                                        MinimumHeightRequest="{OnPlatform WinUI=0}"
                                        Padding="{OnPlatform WinUI=3,
                                                             Android=13,
                                                             iOS=13,
                                                             MacCatalyst=8}"
                                        Opacity="0.82"
                                        Clicked="EditWebsite_Clicked"/>

                                    <!-- Notepad -->
                                    <Button
                                        ImageSource="{AppThemeBinding Light=note_light.png, Dark=note_dark.png}"
                                        BackgroundColor="Transparent"
                                        WidthRequest="{OnPlatform WinUI=30,
                                                                  Android=42,
                                                                  iOS=42,
                                                                  MacCatalyst=30}"
                                        HeightRequest="{OnPlatform WinUI=30,
                                                                   Android=42,
                                                                   iOS=42,
                                                                   MacCatalyst=30}"
                                        MinimumHeightRequest="{OnPlatform WinUI=0}"
                                        Padding="{OnPlatform WinUI=3,
                                                             Android=13,
                                                             iOS=13,
                                                             MacCatalyst=8}"
                                        Opacity="0.82"
                                        Clicked="NotepadButton_Clicked">

                                        <Button.Triggers>

                                            <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding Note.HasNote}"
                                                Value="True">

                                                <Setter
                                                    Property="ImageSource"
                                                    Value="{AppThemeBinding
                                                        Light=note_yellow_light.png,
                                                        Dark=note_yellow.png}"/>

                                                <Setter
                                                    Property="Opacity"
                                                    Value="1"/>

                                            </DataTrigger>

                                        </Button.Triggers>

                                    </Button>

                                    <!-- Website Delete -->
                                    <Button
                                        ImageSource="{AppThemeBinding Light=delete_light.png, Dark=delete_dark.png}"
                                        BackgroundColor="Transparent"
                                        WidthRequest="{OnPlatform WinUI=30,
                                                                  Android=42,
                                                                  iOS=42,
                                                                  MacCatalyst=30}"
                                        HeightRequest="{OnPlatform WinUI=30,
                                                                   Android=42,
                                                                   iOS=42,
                                                                   MacCatalyst=30}"
                                        MinimumHeightRequest="{OnPlatform WinUI=0}"
                                        Padding="{OnPlatform WinUI=3,
                                                             Android=13,
                                                             iOS=13,
                                                             MacCatalyst=8}"
                                        Margin="{OnPlatform WinUI='1,0,0,0',
                                                            Android='3,0,0,0',
                                                            iOS='3,0,0,0',
                                                            MacCatalyst='2,0,0,0'}"
                                        Opacity="0.82"
                                        Clicked="DeleteWebsite_Clicked">

                                        <Button.Triggers>

                                            <DataTrigger
                                                TargetType="Button"
                                                Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentView}},
                                                                  Path=Settings.ConfirmDelete}"
                                                Value="False">

                                                <Setter
                                                    Property="ImageSource"
                                                    Value="delete_red.png"/>

                                                <Setter
                                                    Property="Opacity"
                                                    Value="1"/>

                                            </DataTrigger>

                                        </Button.Triggers>

                                    </Button>

                                </HorizontalStackLayout>

                            </Grid>

                            <!-- Website Separator -->
                            <BoxView
                                Grid.Row="1"
                                HeightRequest="1"
                                Margin="4,0,4,0"
                                BackgroundColor="{AppThemeBinding
                                    Light=#D9E2F0,
                                    Dark=#304866}"/>

                        </Grid>

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView>