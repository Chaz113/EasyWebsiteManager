<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.CategoryView">

    <Border
        Margin="0,4"
        Padding="0"
        Stroke="{AppThemeBinding Light=#B7CAE8, Dark=#41628F}"
        StrokeThickness="1"
        BackgroundColor="{AppThemeBinding Light=#F7FAFE, Dark=#1B2940}">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto,Auto">

            <!-- Category Header -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                Padding="12,9">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CategoryTapped"/>
                </Grid.GestureRecognizers>

                <Label
                    Grid.Column="0"
                    Text="{Binding Name}"
                    FontAttributes="Bold"
                    FontSize="18"
                    VerticalOptions="Center"/>

                <Label
                    Grid.Column="1"
                    Text="›"
                    FontSize="22"
                    VerticalOptions="Center">

                    <Label.Triggers>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding IsExpanded}"
                            Value="True">
                            <Setter Property="Rotation" Value="90"/>
                        </DataTrigger>

                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding IsExpanded}"
                            Value="False">
                            <Setter Property="Rotation" Value="0"/>
                        </DataTrigger>

                    </Label.Triggers>

                </Label>

            </Grid>

            <!-- Website Area -->
            <VerticalStackLayout
                Grid.Row="1"
                IsVisible="{Binding IsExpanded}"
                BindableLayout.ItemsSource="{Binding Websites}"
                Padding="12,0,12,7"
                Spacing="1">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="4,2"
                            MinimumHeightRequest="34">

                            <!-- Website Name -->
                            <Label
                                Grid.Column="0"
                                Text="{Binding Name}"
                                FontSize="15"
                                VerticalOptions="Center"/>

                            <!-- Website Actions -->
                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="5"
                                VerticalOptions="Center">

                                <!-- Edit -->
                                <Button
                                    Text="✏"
                                    FontSize="17"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    Clicked="EditWebsite_Clicked"/>

                                <!-- Notepad -->
                                <Button
                                    Text="▤"
                                    FontSize="17"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"/>

                                <!-- Delete -->
                                <Button
                                    Text="⌫"
                                    FontSize="17"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    Margin="5,0,0,0"/>

                            </HorizontalStackLayout>

                        </Grid>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView> 