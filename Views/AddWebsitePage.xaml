<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.AddWebsitePage"
    Title="Add Website"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <Grid
        Padding="24"
        RowDefinitions="*,Auto,*">

        <Border
            Grid.Row="1"
            MaximumWidthRequest="500"
            HorizontalOptions="Center"
            Padding="24"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2940}"
            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#41628F}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="14">

                <Label
                    Text="Add Website"
                    FontSize="24"
                    FontAttributes="Bold"/>

                <!-- =================================================
                     NORMAL + BUTTON CATEGORY SELECTION
                     ================================================= -->

                <VerticalStackLayout
                    x:Name="CategorySelectionSection"
                    Spacing="14">

                    <!-- Existing Category -->
                    <Label
                        Text="Select Existing Category"
                        FontSize="14"/>

                    <Border
                        Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                        Padding="0"
                        HeightRequest="46">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Picker
                            x:Name="CategoryPicker"
                            ItemsSource="{Binding Categories}"
                            ItemDisplayBinding="{Binding Name}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"
                            Margin="10,0"
                            SelectedIndexChanged="CategoryPicker_SelectedIndexChanged"/>

                    </Border>

                    <!-- New Category -->
                    <Label
                        Text="New Category Name"
                        FontSize="14"/>

                    <Entry
                        x:Name="NewCategoryEntry"
                        Placeholder="Enter a new category name"
                        TextChanged="NewCategoryEntry_TextChanged"/>

                </VerticalStackLayout>

                <!-- =================================================
                     EDIT CATEGORY FIXED CATEGORY
                     ================================================= -->

                <VerticalStackLayout
                    x:Name="FixedCategorySection"
                    IsVisible="False"
                    Spacing="6">

                    <Label
                        Text="Category"
                        FontSize="14"/>

                    <Border
                        Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                        Padding="12,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Label
                            x:Name="FixedCategoryNameLabel"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"/>

                    </Border>

                </VerticalStackLayout>

                <!-- Website Name -->
                <Label
                    Text="Website Name"
                    FontSize="14"/>

                <Entry
                    x:Name="WebsiteNameEntry"
                    Placeholder="Website name"/>

                <!-- URL -->
                <Label
                    Text="Website URL"
                    FontSize="14"/>

                <Entry
                    x:Name="UrlEntry"
                    Placeholder="example.com"
                    Keyboard="Url"/>

                <!-- Cancel / Save -->
                <HorizontalStackLayout
                    HorizontalOptions="End"
                    Spacing="10"
                    Margin="0,8,0,0">

                    <Button
                        Text="Cancel"
                        WidthRequest="90"
                        Clicked="CancelButton_Clicked"/>

                    <Button
                        Text="Save"
                        WidthRequest="90"
                        BackgroundColor="#3478F6"
                        TextColor="White"
                        BorderWidth="0"
                        Clicked="SaveButton_Clicked"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>