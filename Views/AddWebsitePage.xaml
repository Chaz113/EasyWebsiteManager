<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.AddWebsitePage"
    Title="Add Website"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <ScrollView
        VerticalScrollBarVisibility="Default">

        <VerticalStackLayout
            Padding="8"
            Spacing="0">

            <Border
                WidthRequest="340"
                MaximumWidthRequest="500"
                HorizontalOptions="Center"
                Padding="10"
                Margin="0,2"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2940}"
                Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#41628F}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Add Website"
                        FontSize="22"
                        FontAttributes="Bold"
                        Margin="0,0,0,2"/>

                    <!-- =================================================
                         NORMAL CATEGORY SELECTION
                         ================================================= -->

                    <VerticalStackLayout
                        x:Name="CategorySelectionSection"
                        Spacing="3">

                        <!-- Existing Category -->
                        <Label
                            Text="Select Existing Category"
                            FontSize="13"
                            FontAttributes="Bold"/>

                        <!-- Cross-platform inline dropdown: no native radio-button dialog -->
                        <Border
                            HeightRequest="44"
                            Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                            Padding="10,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CategoryDropdown_Tapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label
                                    x:Name="SelectedCategoryLabel"
                                    Text="Select"
                                    TextColor="{AppThemeBinding Light=#C4C4C4, Dark=#858585}"
                                    VerticalOptions="Center"
                                    InputTransparent="True"/>
                                <Label
                                    Grid.Column="1"
                                    Text="▼"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"
                                    VerticalOptions="Center"
                                    InputTransparent="True"/>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="CategoryDropdownList"
                            IsVisible="False"
                            Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                            Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>
                            <CollectionView
                                x:Name="CategoryOptions"
                                ItemsSource="{Binding Categories}"
                                SelectionMode="None"
                                HeightRequest="180">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,10" MinimumHeightRequest="42">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="CategoryOption_Tapped"/>
                                            </Grid.GestureRecognizers>
                                            <Label
                                                Text="{Binding Name}"
                                                TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"
                                                VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>

                        <!-- New Category -->
                        <Label
                            Text="New Category Name"
                            FontSize="13"
                            FontAttributes="Bold"
                            Margin="0,1,0,0"/>

                        <Border
                            HeightRequest="40"
                            Padding="8,0"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                            Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>

                            <Entry
                                x:Name="NewCategoryEntry"
                                Placeholder="Enter a new category name"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"
                                VerticalOptions="Center"
                                TextChanged="NewCategoryEntry_TextChanged"/>

                        </Border>

                    </VerticalStackLayout>

                    <!-- =================================================
                         FIXED CATEGORY
                         ================================================= -->

                    <VerticalStackLayout
                        x:Name="FixedCategorySection"
                        IsVisible="False"
                        Spacing="3">

                        <Label
                            Text="Category"
                            FontSize="13"
                            FontAttributes="Bold"/>

                        <Border
                            HeightRequest="50"
                            MinimumWidthRequest="270"
                            HorizontalOptions="Fill"
                            Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                            Padding="12,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>

                            <Label
                                x:Name="FixedCategoryNameLabel"
                                FontSize="15"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"/>

                        </Border>

                    </VerticalStackLayout>

                    <!-- =================================================
                         WEBSITE NAME
                         ================================================= -->

                    <Label
                        Text="Website Name"
                        FontSize="13"
                        FontAttributes="Bold"
                        Margin="0,1,0,0"/>

                    <Border
                        HeightRequest="40"
                        Padding="8,0"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                        Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Entry
                            x:Name="WebsiteNameEntry"
                            Placeholder="Website name"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"
                            VerticalOptions="Center"/>

                    </Border>

                    <!-- =================================================
                         WEBSITE URL
                         ================================================= -->

                    <Label
                        Text="Website URL"
                        FontSize="13"
                        FontAttributes="Bold"
                        Margin="0,1,0,0"/>

                    <Border
                        HeightRequest="40"
                        Padding="8,0"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#142033}"
                        Stroke="{AppThemeBinding Light=#B8B8B8, Dark=#41628F}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Entry
                            x:Name="UrlEntry"
                            Placeholder="example.com"
                            Keyboard="Url"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#222222, Dark=#F0F0F0}"
                            VerticalOptions="Center"/>

                    </Border>

                    <!-- =================================================
                         CANCEL / SAVE
                         ================================================= -->

                    <HorizontalStackLayout
                        HorizontalOptions="End"
                        Spacing="6"
                        Margin="0,2,0,0">

                        <Button
                            Text="Cancel"
                            WidthRequest="86"
                            HeightRequest="36"
                            FontSize="13"
                            Clicked="CancelButton_Clicked"/>

                        <Button
                            Text="Save"
                            WidthRequest="86"
                            HeightRequest="36"
                            FontSize="13"
                            BackgroundColor="#3478F6"
                            TextColor="White"
                            BorderWidth="0"
                            Clicked="SaveButton_Clicked"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>