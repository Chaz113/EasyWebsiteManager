<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.SettingsPage"
    Title="Settings"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <Grid
        Padding="24"
        RowDefinitions="*,Auto,*">

        <Border
            Grid.Row="1"
            MaximumWidthRequest="{OnPlatform WinUI=365, Android=500, iOS=500, MacCatalyst=500}"
            HorizontalOptions="Center"
            Padding="24"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2940}"
            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#41628F}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="22">

                <Label
                    Text="Settings"
                    FontSize="24"
                    FontAttributes="Bold"/>

                <!-- Confirm Delete -->
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="Confirm Delete"
                        FontSize="16"
                        VerticalOptions="Center"/>

                    <Label
                        x:Name="ConfirmDeleteStatusLabel"
                        Grid.Column="1"
                        Text="ON"
                        FontSize="14"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>

                    <Switch
    x:Name="ConfirmDeleteSwitch"
    Grid.Column="2"
    VerticalOptions="Center"/>

                </Grid>

                <!-- Appearance -->
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="Appearance Mode"
                        FontSize="16"
                        VerticalOptions="Center"/>

                    <Label
                        x:Name="AppearanceStatusLabel"
                        Grid.Column="1"
                        Text="Light"
                        FontSize="14"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>

                    <Switch
    x:Name="DarkModeSwitch"
    Grid.Column="2"
    VerticalOptions="Center"/>

                </Grid>
                <!-- Data actions on the left; smaller information actions on the right. -->
                <Grid
                    ColumnDefinitions="*,100"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="12">

                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Export / Save"
                        BackgroundColor="#0F8B8D"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="44"
                        Clicked="ExportDataButton_Clicked"/>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Help"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="13"
                        VerticalOptions="Center"
                        Clicked="HelpButton_Clicked"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Import / Open"
                        BackgroundColor="#0F8B8D"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="44"
                        Clicked="ImportDataButton_Clicked"/>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="About"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="13"
                        VerticalOptions="Center"
                        Clicked="AboutButton_Clicked"/>
                </Grid>

                <!-- Windows-only Microsoft Store review invitation. -->
                <VerticalStackLayout
                    Spacing="8"
                    IsVisible="{OnPlatform WinUI=True, Android=False, iOS=False, MacCatalyst=False}">

                    <Label
                        Text="Please rate and write a review of Easy Website Manager in Microsoft Store."
                        FontSize="13"
                        HorizontalTextAlignment="Center"/>

                    <Button
                        Text="★  Rate &amp; Review"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Clicked="RateAndReviewButton_Clicked"/>
                </VerticalStackLayout>

                <!-- Android-only Google Play review invitation. -->
                <VerticalStackLayout
                    Spacing="8"
                    IsVisible="{OnPlatform WinUI=False, Android=True, iOS=False, MacCatalyst=False}">

                    <Label
                        Text="Please rate and write a review of Easy Website Manager in Google Play."
                        FontSize="13"
                        HorizontalTextAlignment="Center"/>

                    <Button
                        Text="★  Rate &amp; Review"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Clicked="RateAndReviewButton_Clicked"/>
                </VerticalStackLayout>

                <Button
                    Text="Close"
                    HorizontalOptions="End"
                    WidthRequest="80"
                    HeightRequest="36"
                    FontSize="13"
                    CornerRadius="8"
                    BackgroundColor="#475569"
                    TextColor="White"
                    Clicked="CloseButton_Clicked"/>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>