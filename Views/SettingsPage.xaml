<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.SettingsPage"
    Title="Settings"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <Grid
        Padding="24"
        RowDefinitions="*,Auto,*">

        <Border
            Grid.Row="1"
            MaximumWidthRequest="500"
            HorizontalOptions="Center"
            Padding="24"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2940}"
            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#41628F}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="22">

                <Label
                    Text="Settings"
                    FontSize="24"
                    FontAttributes="Bold"/>

                <!-- Confirm Delete -->
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="Confirm Delete"
                        FontSize="16"
                        VerticalOptions="Center"/>

                    <Label
                        x:Name="ConfirmDeleteStatusLabel"
                        Grid.Column="1"
                        Text="ON"
                        FontSize="14"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>

                    <Switch
                        x:Name="ConfirmDeleteSwitch"
                        Grid.Column="2"
                        VerticalOptions="Center"/>

                </Grid>

                <!-- Appearance -->
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="Appearance Mode"
                        FontSize="16"
                        VerticalOptions="Center"/>

                    <Label
                        x:Name="AppearanceStatusLabel"
                        Grid.Column="1"
                        Text="Light"
                        FontSize="14"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>

                    <Switch
                        x:Name="DarkModeSwitch"
                        Grid.Column="2"
                        VerticalOptions="Center"/>

                </Grid>
                <Button
    Text="Export Data"
    HorizontalOptions="Start"
    WidthRequest="120"
    Clicked="ExportDataButton_Clicked"/>

                <Button
    Text="Import Data"
    HorizontalOptions="Start"
    WidthRequest="120"
    Clicked="ImportDataButton_Clicked"/>

                <Button
                    Text="Close"
                    HorizontalOptions="End"
                    WidthRequest="90"
                    Clicked="CloseButton_Clicked"/>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>