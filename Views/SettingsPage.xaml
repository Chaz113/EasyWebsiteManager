<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.SettingsPage"
    Title="Settings"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <Grid
        Padding="24"
        RowDefinitions="*,Auto,*">

        <Border
            Grid.Row="1"
            MaximumWidthRequest="500"
            HorizontalOptions="Center"
            Padding="24"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2940}"
            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#41628F}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="18">

                <Label
                    Text="Settings"
                    FontSize="24"
                    FontAttributes="Bold"/>

                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="16">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="2">

                        <Label
                            Text="Confirm Delete"
                            FontSize="16"/>

                        <Label
                            Text="Ask before deleting a website."
                            FontSize="13"
                            Opacity="0.7"/>

                    </VerticalStackLayout>

                    <Switch
                        x:Name="ConfirmDeleteSwitch"
                        Grid.Column="1"
                        VerticalOptions="Center"/>

                </Grid>

                <Button
                    Text="Close"
                    HorizontalOptions="End"
                    WidthRequest="90"
                    Clicked="CloseButton_Clicked"/>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>