<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EasyWebsiteManager.Views.EditCategoryPage"
    Title="Edit Category"
    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <Grid
        Padding="{OnPlatform WinUI=24, Android=16, iOS=16, MacCatalyst=20}"
        RowDefinitions="*,Auto,*">

        <Border
            Grid.Row="1"
            MaximumWidthRequest="500"
            HorizontalOptions="Fill"
            Padding="{OnPlatform WinUI=24, Android=16, iOS=16, MacCatalyst=20}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B2940}"
            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#41628F}"
            StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="14">

                <Label
                    Text="Edit Category"
                    FontSize="24"
                    FontAttributes="Bold"/>

                <Label
                    Text="Category Name"
                    FontSize="14"/>

                <Entry
                    x:Name="CategoryNameEntry"
                    Placeholder="Category name"/>

                <Label
                    Text="Category Text Color"
                    FontSize="14"/>

                <!-- Responsive color palette -->
                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Start">

                    <Button
                        x:Name="BlackColorButton"
                        BackgroundColor="#000000"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="BlackColor_Clicked"/>

                    <Button
                        x:Name="WhiteColorButton"
                        BackgroundColor="#FFFFFF"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderColor="#888888"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="WhiteColor_Clicked"/>

                    <Button
                        x:Name="BlueColorButton"
                        BackgroundColor="#0000CD"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="BlueColor_Clicked"/>

                    <Button
                        x:Name="RedColorButton"
                        BackgroundColor="#FF0000"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="RedColor_Clicked"/>

                    <Button
                        x:Name="GreenColorButton"
                        BackgroundColor="#00FF00"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="GreenColor_Clicked"/>

                    <Button
                        x:Name="OrangeColorButton"
                        BackgroundColor="#FFA500"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="OrangeColor_Clicked"/>

                    <Button
                        x:Name="PurpleColorButton"
                        BackgroundColor="#4B0082"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="PurpleColor_Clicked"/>

                    <Button
                        x:Name="VioletColorButton"
                        BackgroundColor="#8F00FF"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="VioletColor_Clicked"/>

                    <Button
                        x:Name="LightGreyColorButton"
                        BackgroundColor="#D3D3D3"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="LightGreyColor_Clicked"/>

                    <Button
                        x:Name="MediumGreyColorButton"
                        BackgroundColor="#808080"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="MediumGreyColor_Clicked"/>

                    <Button
                        x:Name="TealColorButton"
                        BackgroundColor="#008080"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="TealColor_Clicked"/>

                    <Button
                        x:Name="YellowColorButton"
                        BackgroundColor="#FFD700"
                        WidthRequest="32"
                        HeightRequest="32"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        CornerRadius="16"
                        BorderWidth="1"
                        Margin="0,0,8,8"
                        Padding="0"
                        Clicked="YellowColor_Clicked"/>

                </FlexLayout>

                <Button
                    Text="+  Add Website"
                    HorizontalOptions="Start"
                    WidthRequest="150"
                    HeightRequest="44"
                    Margin="0,8,0,0"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#3478F6, Dark=#7FB0FF}"
                    BorderColor="{AppThemeBinding Light=#3478F6, Dark=#3478F6}"
                    BorderWidth="2"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    Clicked="AddWebsiteButton_Clicked"/>

                <HorizontalStackLayout
                    HorizontalOptions="End"
                    Spacing="10"
                    Margin="0,8,0,0">

                    <Button
                        Text="Cancel"
                        WidthRequest="90"
                        Clicked="CancelButton_Clicked"/>

                    <Button
                        Text="Save"
                        WidthRequest="90"
                        BackgroundColor="#3478F6"
                        TextColor="White"
                        BorderWidth="0"
                        Clicked="SaveButton_Clicked"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>