<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EasyWebsiteManager.Views"
    x:Class="EasyWebsiteManager.MainPage">

    <Grid
        Padding="15"
        RowDefinitions="Auto,*">

        <!-- Top Bar -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10">
            <Button
    Grid.Column="0"
    Text="Home"
    FontSize="14"
    BackgroundColor="Transparent"
    TextColor="{AppThemeBinding Light=Black, Dark=White}"
    Padding="8,0"
    Clicked="HomeButton_Clicked"/>

            <!-- Search: consistent outline and icon in both themes -->
            <Border
                Grid.Column="1"
                HeightRequest="44"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}"
                Stroke="{AppThemeBinding Light=#B8BEC7, Dark=#3B3B3B}"
                StrokeThickness="1"
                Padding="10,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry
                        x:Name="SearchEntry"
                        HandlerChanged="SearchEntry_HandlerChanged"
                        Grid.Column="0"
                        Placeholder="Search websites..."
                        Text="{Binding SearchText}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#202020, Dark=#FFFFFF}"
                        PlaceholderColor="{AppThemeBinding Light=#757575, Dark=#858585}"
                        ClearButtonVisibility="WhileEditing"
                        VerticalOptions="Center"
                        FontSize="14"
                        Margin="0"
                        HorizontalOptions="Fill"/>

                    <!-- Thin vector magnifying glass; identical shape on Windows and Android -->
                    <Path
                        Grid.Column="1"
                        Data="M 10,3 A 7,7 0 1 1 10,17 A 7,7 0 1 1 10,3 M 15,15 L 21,21"
                        WidthRequest="20"
                        HeightRequest="20"
                        Aspect="Uniform"
                        Fill="Transparent"
                        Stroke="{AppThemeBinding Light=#333333, Dark=#D0D0D0}"
                        StrokeThickness="1.7"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"/>
                </Grid>
            </Border>


            <!-- Settings -->
            <Button
                Grid.Column="2"
                Text="⚙"
                FontSize="20"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                VerticalOptions="Center"
                Clicked="SettingsButton_Clicked"/>

        </Grid>

        <!-- Categories -->
        <CollectionView
            x:Name="CategoryListView"
            Grid.Row="1"
            Margin="0,8,0,0"
            ItemsSource="{Binding FilteredCategories}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <views:CategoryView/>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Windows-only bottom scroll clearance for the floating Add button. -->
            <CollectionView.Footer>
                <BoxView
                    HeightRequest="{OnPlatform WinUI=90, Android=0, iOS=0, MacCatalyst=0}"
                    Color="Transparent"/>
            </CollectionView.Footer>

        </CollectionView>

        <!-- Compact, left-aligned Undo notification on Android; Windows unchanged -->
        <Border
            x:Name="UndoBanner"
            Grid.RowSpan="2"
            IsVisible="False"
            HorizontalOptions="{OnPlatform Android=Start, WinUI=Center, iOS=Center, MacCatalyst=Center}"
            VerticalOptions="Center"
            WidthRequest="{OnPlatform Android=150, WinUI=240, iOS=240, MacCatalyst=240}"
            MaximumWidthRequest="300"
            Margin="{OnPlatform Android=4, WinUI='12,0', iOS='12,0', MacCatalyst='12,0'}"
            Padding="{OnPlatform Android='8,8', WinUI='16,14', iOS='16,14', MacCatalyst='16,14'}"
            BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2B2B2B}"
            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#4A4A4A}"
            StrokeThickness="1"
            ZIndex="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="{OnPlatform Android=5, WinUI=10, iOS=10, MacCatalyst=10}" HorizontalOptions="Center">
                <Label
                    x:Name="UndoMessageLabel"
                    Text="Website deleted"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center"
                    LineBreakMode="WordWrap"
                    MaxLines="2"
                    FontSize="{OnPlatform Android=12, WinUI=14, iOS=14, MacCatalyst=14}"
                    TextColor="{AppThemeBinding Light=#202020, Dark=#FFFFFF}"/>
                <Button
                    Text="Undo"
                    BackgroundColor="{OnPlatform Android=#FF8C00, WinUI=#FF8C00, iOS=#3478F6, MacCatalyst=#3478F6}"
                    TextColor="{OnPlatform Android=#202020, WinUI=#202020, iOS=White, MacCatalyst=White}"
                    CornerRadius="8"
                    Padding="{OnPlatform Android='8,4', WinUI='20,8', iOS='20,8', MacCatalyst='20,8'}"
                    MinimumWidthRequest="{OnPlatform Android=70, WinUI=100, iOS=100, MacCatalyst=100}"
                    FontSize="{OnPlatform Android=12, WinUI=14, iOS=14, MacCatalyst=14}"
                    HorizontalOptions="Center"
                    Clicked="UndoDelete_Clicked"/>
            </VerticalStackLayout>

        </Border>

        <!-- Floating Add Button -->
        <Button
            x:Name="AddButton"
            Grid.RowSpan="2"
            Text="+"
            FontSize="32"
            FontAttributes="Bold"
            WidthRequest="64"
            HeightRequest="64"
            CornerRadius="32"
            BackgroundColor="#3478F6"
            TextColor="White"
            BorderWidth="0"
            Padding="0"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Margin="0,0,12,12"
            Clicked="AddButton_Clicked"
            ZIndex="10">

            <Button.Shadow>
                <Shadow
                    Brush="Black"
                    Offset="0,4"
                    Radius="8"
                    Opacity="0.30"/>
            </Button.Shadow>

        </Button>

    </Grid>

</ContentPage>